# Copy to .env for the minimal native `docker compose` example.

# HTTP authentication. Set this before exposing the service beyond loopback.
WATERMARKS_SERVER_API_KEY=
WATERMARKS_MAX_BATCH_FILES=50

# Client-side URL used by skills or curl, not by the container itself.
# WATERMARKS_SERVICE_URL=http://127.0.0.1:8765

# Optional external backends are deliberately not part of this Compose file.
# Configure them in an operator-managed environment and point aiwr at an
# adapter directory/sidecar explicitly. Nothing below downloads or installs a
# backend automatically:
#
# AIWR_UPSTREAM_SCRIPTS=/opt/aiwr/adapters
# MARKLLM_DIR=/opt/third-party/MarkLLM
# MARKDIFFUSION_DIR=/opt/third-party/MarkDiffusion
# REVERSE_SYNTHID_DIR=/opt/third-party/reverse-SynthID
# NOAI_WATERMARK_DIR=/opt/third-party/noai-watermark
# WATERMARKS_SYNTHID_SCORER_URL=http://127.0.0.1:8766
# WATERMARKS_SYNTHID_TEXT_URL=http://127.0.0.1:8767
